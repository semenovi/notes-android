<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:Notes.Helpers"
             xmlns:shared="clr-namespace:Notes.Views.Controls"
             xmlns:local="clr-namespace:Notes.Views.Pages"
             x:Class="Notes.Views.Pages.NotesPage"
             Title="{Binding FolderName}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="new subfolder"
                     Order="Secondary"
                     Clicked="OnAddSubfolderClicked" />
        <ToolbarItem Text="change folder icon"
                     Order="Secondary"
                     Clicked="OnChangeFolderIconClicked" />
        <ToolbarItem Text="rename folder"
                     Order="Secondary"
                     Clicked="OnRenameFolderClicked" />
        <ToolbarItem Text="info"
                     Order="Secondary"
                     Clicked="OnFolderInfoClicked" />
        <ToolbarItem Text="delete folder"
                     Order="Secondary"
                     Clicked="OnDeleteFolderClicked" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <DataTemplate x:Key="FolderRowTemplate">
            <Grid Padding="20,10" ColumnDefinitions="Auto,*">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFolderItemTapped" />
                </Grid.GestureRecognizers>
                <Label Grid.Column="0"
                       Text="{Binding Icon}"
                       Style="{StaticResource MaterialIconLabel}"
                       FontSize="24"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{Binding Name}"
                       FontSize="16"
                       VerticalOptions="Center"
                       Margin="12,0,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="NoteRowTemplate">
            <Grid Padding="20,10" ColumnDefinitions="Auto,*">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNoteTapped" />
                </Grid.GestureRecognizers>
                <Label Grid.Column="0"
                       Text="{Binding Icon}"
                       Style="{StaticResource MaterialIconLabel}"
                       FontSize="24"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                       VerticalOptions="Center" />
                <StackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                    <Label Text="{Binding Title}"
                           FontSize="18"
                           FontAttributes="Bold" />
                    <Label Text="{Binding Modified, StringFormat='{0:g}'}"
                           FontSize="12"
                           TextColor="Gray" />
                </StackLayout>
            </Grid>
        </DataTemplate>

        <local:NotesPageItemTemplateSelector x:Key="ItemTemplateSelector"
                                              FolderTemplate="{StaticResource FolderRowTemplate}"
                                              NoteTemplate="{StaticResource NoteRowTemplate}" />
    </ContentPage.Resources>

    <Grid IsClippedToBounds="False">
        <!-- Current screen — опaque, slides right on swipe -->
        <Grid x:Name="RootGrid"
              IsClippedToBounds="False"
              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
            <!-- BindableLayout instead of CollectionView: drag-and-drop here is driven
                 by our own touch tracking (see MainActivity/DragReorderGesture), which
                 hit-tests directly against ItemsStack.Children — a real, enumerable view
                 tree. CollectionView virtualizes/recycles rows, which doesn't give that.
                 Folder/note counts here are small, so skipping virtualization costs
                 nothing in practice. -->
            <ScrollView>
                <Grid RowDefinitions="Auto,Auto">
                    <VerticalStackLayout x:Name="ItemsStack"
                                         Grid.Row="0"
                                         BindableLayout.ItemsSource="{Binding Items}"
                                         BindableLayout.ItemTemplateSelector="{StaticResource ItemTemplateSelector}" />

                    <StackLayout Grid.Row="1"
                                 IsVisible="{Binding IsEmpty}"
                                 Margin="0,60,0,0"
                                 HorizontalOptions="Center">
                        <Label Text="this folder is empty" FontSize="18" HorizontalOptions="Center" TextColor="Gray" />
                        <Label Text="add a note or subfolder" FontSize="14" HorizontalOptions="Center" TextColor="Gray" />
                    </StackLayout>
                </Grid>
            </ScrollView>

            <!-- Drop target for "move up a level" while dragging a note/folder.
                 Anchored to the bottom, not the top: folders always sort first in
                 the list, so a top-anchored bar would sit right on top of them and
                 block the most common drop target. Still overlaid in the same Grid
                 cell (no row of its own), so showing/hiding it never shifts rows.
                 Always present (not IsVisible-toggled) — shown/hidden purely via a
                 slide+fade animation driven from IsDragActive in code-behind, so it
                 arrives/leaves instead of popping in and out. -->
            <Border x:Name="MoveUpZone"
                    Opacity="0"
                    TranslationY="30"
                    InputTransparent="True"
                    VerticalOptions="End"
                    HeightRequest="56"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#DCE9FF, Dark=#1E3A6E}"
                    Padding="20,0">
                <Label Text="&#9650; move up a level"
                       FontSize="14"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            </Border>

            <Button x:Name="AddNoteButton"
                    Text="{x:Static helpers:MaterialIconCodes.Add}"
                    FontFamily="MaterialIcons"
                    FontSize="24"
                    CornerRadius="30"
                    WidthRequest="60"
                    HeightRequest="60"
                    Padding="0"
                    VerticalOptions="End"
                    HorizontalOptions="End"
                    Margin="0,0,20,20"
                    Clicked="OnAddNoteClicked" />

            <!-- Stand-in for the native OS drag shadow, which we no longer trigger.
                 Sized/styled to match FolderRowTemplate/NoteRowTemplate so it reads as
                 "the row, picked up" rather than a smaller, unrelated chip. Positioned
                 by hand (TranslationX/Y) from the raw touch coordinates MainActivity
                 reports; never intercepts touches itself. -->
            <Border x:Name="DragGhost"
                    IsVisible="False"
                    InputTransparent="True"
                    Opacity="0"
                    Scale="0.95"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    WidthRequest="260"
                    Padding="20,10"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
                <HorizontalStackLayout Spacing="12">
                    <Label x:Name="DragGhostIcon"
                           Style="{StaticResource MaterialIconLabel}"
                           FontSize="24"
                           VerticalOptions="Center" />
                    <Label x:Name="DragGhostLabel"
                           FontSize="16"
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation" />
                </HorizontalStackLayout>
            </Border>

        </Grid>

        <!-- Shadow cast from RootGrid onto the previous screen.
             Positioned to the left of RootGrid, moves with it. -->
        <ContentView x:Name="SwipeShadow"
                     WidthRequest="24"
                     HorizontalOptions="Start"
                     VerticalOptions="Fill"
                     InputTransparent="True"
                     Opacity="0">
            <ContentView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#55000000" Offset="1" />
                </LinearGradientBrush>
            </ContentView.Background>
        </ContentView>
    </Grid>
</ContentPage>
